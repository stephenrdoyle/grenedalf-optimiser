#!/usr/bin/env bash
# Stand-in for grenedalf 0.6.3: --help lists the options the driver checks; commands copy the
# simulated "clean" tables, or the simulated frequency table. Like the real one, diversity
# refuses Tajima's D unless --filter-sample-min-count is 2 (or --no-tajima-d is given), and
# checks that total and per-sample masks agree.
set -euo pipefail
if [[ ${1:-} == --version ]]; then echo "grenedalf v0.6.3 (stand-in)"; exit 0; fi
cmd=$1; shift
if [[ ${1:-} == --help ]]; then
    echo "--filter-mask-total-bed --filter-mask-samples-bed-list --filter-region --filter-sample-min-count"
    echo "--filter-sample-min-read-depth --filter-sample-max-read-depth --allow-file-overwriting --no-tajima-d"
    echo "--pool-sizes  Pool sizes: a single number, or a file with sample name and size"
    exit 0
fi
mc="" no_tajima=0 out="" total="" samples=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --out-dir) out=$2 ;;
        --filter-mask-total-bed) total=$2 ;;
        --filter-mask-samples-bed-list) samples=$2 ;;
        --filter-sample-min-count) mc=$2 ;;
        --no-tajima-d) no_tajima=1 ;;
        --filter-mask-sample-bed-list) echo "unknown option $1" >&2; exit 1 ;;
    esac
    shift
done
# Like grenedalf: total and per-sample masks must give the same chromosomes and lengths,
# where a mask's chromosome length is its last masked position
mask_dict() { awk -F'\t' '{if ($3 > m[$1]) m[$1] = $3} END {for (c in m) print c "\t" m[c]}' "$1" | sort; }
if [[ -n $total && -n $samples ]]; then
    while IFS=$'\t' read -r name bed; do
        if [[ "$(mask_dict "$total")" != "$(mask_dict "$bed")" ]]; then
            echo "Error: Provided total mask file and sample mask for sample $name do not contain the exact same chromosomes or lengths of chromosomes." >&2
            exit 1
        fi
    done < "$samples"
fi
if [[ $cmd == diversity && $no_tajima == 0 && $mc != 2 ]]; then
    echo "--filter-sample-min-count: Tajima's D requires the minimum allele count to be exactly 2" >&2
    exit 1
fi
# Usable SNPs per pair scale with how much the masks leave (as in a real run), so runs that
# mask less keep more data; the statistics themselves are the simulated "clean" ones
scale_pairs() {
    python3 - "$1" "$2" "$total" "$samples" "$mc" <<'PY'
import sys, pandas as pd
src, dst, total, samples, mc = sys.argv[1:6]
bp = lambda f: sum(int(l.split("\t")[2]) - int(l.split("\t")[1]) for l in open(f) if l.strip())
masked = bp(total) if total else 0
if samples:
    beds = [l.split("\t")[1].strip() for l in open(samples) if l.strip()]
    masked += sum(bp(b) for b in beds) / max(len(beds), 1) / 3   # per-sample: a pair loses less
t = pd.read_csv(src, sep="\t")
for c in [c for c in t.columns if ":" in c and c.endswith(".passed")]:
    # a lower minimum count keeps more SNPs
    t[c] = (t[c] * 1e6 / (1e6 + masked) * (1 + 0.1 * (3 - int(mc or 3)))).round().astype(int)
t.to_csv(dst, sep="\t", index=False)
PY
}
case $cmd in
    diversity) cp "$SIM_DIR/clean.diversity.csv" "$out/diversity.csv" ;;
    fst) scale_pairs "$SIM_DIR/clean.fst.csv" "$out/fst.csv" ;;
    frequency) gzip -c "$SIM_DIR/frequency.csv" > "$out/frequency.csv.gz" ;;
esac
